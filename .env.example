# HalCTF エージェント設定（ローカル検証用。実行時はプラットフォームが注入する）
#
# 実行時（detonation）に注入され、我々は「読むだけ」の変数（無印が最優先）:
#   OPENAI_BASE_URL  MCP_ENDPOINT  HAL_*(USER ID)  BONUS_FLAG  FLAG_1 ...
# ローカルでは同名 or HALCTF_ 付きで上書きできる。

# 中央 Model Service（OpenAI 互換。api_key は sidecar が注入するので不要）
OPENAI_BASE_URL=http://127.0.0.1:9000/llm
# チャレンジ探索 / 提出の MCP サーバ
MCP_ENDPOINT=http://127.0.0.1:9000/mcp
# sidecar（/submit・/done・全中継）
HAL_SIDECAR_URL=http://127.0.0.1:9000
# 起動 30 秒以内に `USER ID: <uid>` を出すための uid（実行時は HAL_* で注入）
HAL_USER_ID=local-dev-uid
# 提出パイプラインのスモークテスト用フラグ（実行時は自動注入）
# BONUS_FLAG=flag{...}

# モデル多段（小型優先。左が最優先）
HALCTF_MODEL_CHAIN=llama3-2,llama-3.1-8b,qwen3.6-35b-a3b,google/gemma-4-26b-a4b-it-maas

# ループ / 実行制御
HALCTF_MAX_STEPS=20
HALCTF_RUN_BUDGET_SEC=3300
HALCTF_HEARTBEAT_SEC=45

# 検知回避（"CAUGHT BY SOC" 対策）
HALCTF_MAX_FLAG_ATTEMPTS=3
HALCTF_TARGET_MIN_INTERVAL_SEC=0.4

# ローカル検証: true でモック（外部 API 不要）
HALCTF_USE_MOCK=true
