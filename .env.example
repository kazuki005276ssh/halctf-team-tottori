# HalCTF エージェント設定（実値は .env にコピーして記入。コミット禁止）
# API 仕様は未確定のため、確定次第ここのキー名を spec/ と揃える。

# 中央 Model Service（OpenAI 互換）
HALCTF_MODEL_BASE_URL=http://localhost:8000/v1
HALCTF_MODEL_API_KEY=changeme
# 小型優先 → 難所フォールバックの多段（カンマ区切り、左が最優先）
HALCTF_MODEL_CHAIN=Llama-3.2-3B,Qwen3.5-4B,gpt-oss-120b

# フラグ提出 API（未確定。確定したら差し替え）
HALCTF_SUBMIT_BASE_URL=http://localhost:8000
HALCTF_SUBMIT_PATH=/submit
HALCTF_COMPLETION_PATH=/complete

# フラグ形式（正規表現。確定形式に差し替え）
HALCTF_FLAG_REGEX=flag\{[^}]+\}

# ループ制御
HALCTF_MAX_STEPS=20
HALCTF_STEP_TIMEOUT_SEC=60
HALCTF_RUN_BUDGET_SEC=900

# ローカル検証用: mock を使うと外部 API なしで end-to-end が回る
HALCTF_USE_MOCK=true
